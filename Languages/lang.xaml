<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:System;assembly=mscorlib">
    <v:String x:Key="Stopwatch">Stopwatch</v:String>
    <v:String x:Key="Timer">Timer</v:String>
    <v:String x:Key="Start">Start</v:String>
    <v:String x:Key="Stop">Stop</v:String>
    <v:String x:Key="Cutoff">Cutoff</v:String>

    <v:String x:Key="Reset">Reset</v:String>
    <v:String x:Key="AddSec10">+10 sec</v:String>
    <v:String x:Key="AddSec60">+1 min</v:String>
    <v:String x:Key="AddSec300">+5 min</v:String>
    <v:String x:Key="AddSec1200">+20 min</v:String>
    <v:String x:Key="AddSec3600">+1 hour</v:String>
    <v:String x:Key="AddSec21600">+6 hours</v:String>

</ResourceDictionary>